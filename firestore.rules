rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(householdId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      // Index of which households this user belongs to (a user can now be
      // in more than one: their Personal household plus any joined ones).
      match /households/{householdId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Join-code -> householdId lookup, so a non-member can resolve a shared
    // 8-digit code to a household id via a single get(). Deliberately not
    // queryable/listable against `households` directly, so codes can't be
    // enumerated by scanning.
    match /joinCodes/{code} {
      allow get: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /households/{householdId} {
      allow create: if isSignedIn();
      allow read, update: if isMember(householdId);
      allow delete: if false;

      match /members/{memberId} {
        // A user can always read their own membership doc, even if it
        // doesn't exist yet (isMember() alone would deny that read, since
        // it checks exists() on this same doc). This lets client code
        // detect and repair a missing membership doc.
        allow read: if isMember(householdId) || (isSignedIn() && request.auth.uid == memberId);
        // A user may add themself as a member — either bootstrapping their
        // own new household as its owner, or joining an existing one found
        // via a join code (always as a plain member). Only the household's
        // creator may self-assign the 'owner' role, so a shared join code
        // can't be used to grant someone else elevated access.
        //
        // getAfter() (not get()) is required here: the household doc and
        // this owner membership doc are created in the same
        // transaction/batch, and get() only sees already-committed state —
        // it wouldn't see the household doc's createdByUserId that's being
        // set in that same atomic write.
        allow create: if isSignedIn() && request.auth.uid == memberId &&
          (request.resource.data.role == 'member' ||
            (request.resource.data.role == 'owner' &&
              request.auth.uid ==
                getAfter(/databases/$(database)/documents/households/$(householdId)).data.createdByUserId));
        allow update, delete: if isMember(householdId);
      }

      match /ingredients/{ingredientId} {
        allow read, write: if isMember(householdId);
      }

      match /categories/{categoryId} {
        allow read, write: if isMember(householdId);
      }

      match /units/{unitId} {
        allow read, write: if isMember(householdId);
      }

      match /recipes/{recipeId} {
        allow read, write: if isMember(householdId);
      }

      match /userLogs/{logId} {
        allow read, write: if isMember(householdId);
      }

      match /recipeLogs/{logId} {
        allow read, write: if isMember(householdId);
      }

      match /ingredientLogs/{logId} {
        allow read, write: if isMember(householdId);
      }
    }
  }
}
