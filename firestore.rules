rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(householdId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /households/{householdId} {
      allow create: if isSignedIn();
      allow read, update: if isMember(householdId);
      allow delete: if false;

      match /members/{memberId} {
        // A user can always read their own membership doc, even if it
        // doesn't exist yet (isMember() alone would deny that read, since
        // it checks exists() on this same doc). This lets client code
        // detect and repair a missing membership doc.
        allow read: if isMember(householdId) || (isSignedIn() && request.auth.uid == memberId);
        // A user may add themself as a member (e.g. bootstrapping their
        // own starter household). Adding other members isn't supported yet.
        allow create: if isSignedIn() && request.auth.uid == memberId;
        allow update, delete: if isMember(householdId);
      }

      match /ingredients/{ingredientId} {
        allow read, write: if isMember(householdId);
      }

      match /categories/{categoryId} {
        allow read, write: if isMember(householdId);
      }

      match /units/{unitId} {
        allow read, write: if isMember(householdId);
      }

      match /recipes/{recipeId} {
        allow read, write: if isMember(householdId);
      }

      match /userLogs/{logId} {
        allow read, write: if isMember(householdId);
      }

      match /recipeLogs/{logId} {
        allow read, write: if isMember(householdId);
      }

      match /ingredientLogs/{logId} {
        allow read, write: if isMember(householdId);
      }
    }
  }
}
